
on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar projeto
        uses: actions/checkout@v4

      - name: Localizar projeto
        id: locate
        run: |
          if [ -f "package.json" ]; then
            DIR="."
          else
            FILE=$(find . -mindepth 2 -maxdepth 5 -type f -name package.json -not -path '*/node_modules/*' | head -n 1)
            if [ -z "$FILE" ]; then
              echo "ERRO: package.json não encontrado"
              exit 1
            fi
            DIR=$(dirname "$FILE")
          fi
          echo "dir=$DIR" >> "$GITHUB_OUTPUT"
          echo "Projeto localizado em: $DIR"

      - name: Configurar Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Configurar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Instalar dependências
        working-directory: ${{ steps.locate.outputs.dir }}
        run: npm install

      - name: Criar Android se necessário
        working-directory: ${{ steps.locate.outputs.dir }}
        run: |
          if [ ! -d android ]; then
            npx cap add android
          fi

      - name: Sincronizar Capacitor
        working-directory: ${{ steps.locate.outputs.dir }}
        run: npx cap sync android

      - name: Compilar APK
        working-directory: ${{ steps.locate.outputs.dir }}/android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: Carreira-de-Craque-APK-debug
          path: ${{ steps.locate.outputs.dir }}/android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
